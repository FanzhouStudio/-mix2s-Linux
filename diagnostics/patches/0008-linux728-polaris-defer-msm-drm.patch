+static void polaris_drm_delayed_register(struct work_struct *work)
+{
+	pr_info("Polaris diagnostic: starting deferred MSM DRM registration\n");
+	msm_drm_register_now();
+}
+
+static DECLARE_DELAYED_WORK(polaris_drm_register_work,
+			   polaris_drm_delayed_register);
+
+static int __init msm_drm_register(void)
+{
+	if (of_machine_is_compatible("xiaomi,polaris")) {
+		pr_info("Polaris diagnostic: MSM DRM registration deferred 45 seconds\n");
+		schedule_delayed_work(&polaris_drm_register_work,
+				      msecs_to_jiffies(45000));
+		return 0;
+	}
+
+	return msm_drm_register_now();
+}
+
 static void __exit msm_drm_unregister(void)
 {
+	cancel_delayed_work_sync(&polaris_drm_register_work);
 	DBG("fini");
 	msm_mdss_unregister();
 	msm_mdp4_unregister();
