#!/bin/sh
# Runs only in the 7.2.8 RAM overlay. Each stage can be inspected in journalctl.
set -eu
[ "$(uname -r)" = 7.2.8-polaris ] || exit 0
# The first automatic boot raced ModemManager against the remote firmware
# servers. Start the Qualcomm services before ModemManager probes the modem.
systemctl stop ModemManager.service || true
sleep 2
/usr/local/sbin/polaris-integrated-bringup core
if ! /usr/local/sbin/polaris-integrated-bringup audio; then
    echo 'POLARIS 7.2.8: audio bringup failed; continuing with networking' >&2
fi
if ! /usr/local/sbin/polaris-integrated-bringup cellular; then
    echo 'POLARIS 7.2.8: cellular bringup failed' >&2
fi

# ath10k probes asynchronously. If its first attempt raced a modem recovery,
# wait for that attempt to finish and retry the platform bind once only.
n=0
while [ "$n" -lt 20 ] && [ ! -e /sys/class/net/wlan0 ]; do
    sleep 2
    n=$((n+1))
done
if [ ! -e /sys/class/net/wlan0 ] &&
   [ -L /sys/bus/platform/devices/18800000.wifi/driver ] &&
   [ -w /sys/bus/platform/drivers/ath10k_snoc/unbind ] &&
   [ -w /sys/bus/platform/drivers/ath10k_snoc/bind ]; then
    echo 'POLARIS 7.2.8: retrying Wi-Fi probe after firmware services settled'
    echo 18800000.wifi >/sys/bus/platform/drivers/ath10k_snoc/unbind
    sleep 2
    echo 18800000.wifi >/sys/bus/platform/drivers/ath10k_snoc/bind
fi

# The SIM session and LTE mode may be accepted before the modem can register.
# On two RAM boots, repeating the same mode request after firmware settled
# completed registration. Never loop indefinitely or reset the modem here.
modem=$(mmcli -L 2>/dev/null | sed -n 's@.*/Modem/\([0-9][0-9]*\).*@\1@p' | head -n 1)
if [ -n "$modem" ]; then
    n=0
    while [ "$n" -lt 9 ]; do
        if mmcli -m "$modem" --output-keyvalue 2>/dev/null |
           grep -Eq '^modem\.3gpp\.registration-state[[:space:]]*:[[:space:]]*(home|roaming)$'; then
            break
        fi
        sleep 10
        n=$((n+1))
    done
    if [ "$n" -ge 9 ]; then
        echo 'POLARIS 7.2.8: retrying LTE preference after modem settled'
        mmcli -m "$modem" --set-allowed-modes='2g|3g|4g' --set-preferred-mode=4g || true
    fi
fi
