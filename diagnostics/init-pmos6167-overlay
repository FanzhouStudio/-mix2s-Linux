#!/bin/sh
# RAM-only diagnostic. All block devices stay read-only; Ubuntu writes go to tmpfs.
export PATH=/bin:/sbin:/usr/bin:/usr/sbin
/bin/busybox mount -t proc proc /proc
/bin/busybox mount -t sysfs sysfs /sys
/bin/busybox mount -t devtmpfs devtmpfs /dev
/bin/busybox mkdir -p /dev/pts /run /tmp
/bin/busybox mount -t devpts devpts /dev/pts
/bin/busybox mount -t tmpfs tmpfs /run
/bin/busybox mount -t tmpfs tmpfs /tmp
/bin/busybox --install -s /bin
exec >>/run/init.log 2>&1
echo 'POLARIS 6.16.7 overlay diagnostic: PID1 ready'
echo 0 >/proc/sys/kernel/panic

protect_blocks() {
    for b in /sys/class/block/*; do
        [ -e "$b" ] || continue
        case "${b##*/}" in sd*|mmcblk*|nvme*) blockdev --setro "/dev/${b##*/}" || true;; esac
    done
}

mount_ro() {
    part=$1; type=$2; opts=$3; dest=$4
    mkdir -p "$dest"
    for event in /sys/class/block/*/uevent; do
        [ -r "$event" ] || continue
        grep -q "^PARTNAME=$part$" "$event" || continue
        b=${event%/uevent}; dev=/dev/${b##*/}
        blockdev --setro "$dev" || return 1
        mount -t "$type" -o "$opts" "$dev" "$dest" && {
            echo "READ-ONLY: $part at $dev"
            return 0
        }
        return 1
    done
    return 1
}

setup_usb() {
    mkdir -p /sys/kernel/config
    mount -t configfs configfs /sys/kernel/config || return 1
    g=/sys/kernel/config/usb_gadget/polaris_diag
    mkdir "$g" || return 1
    echo 0x0525 >"$g/idVendor"
    echo 0xa4a7 >"$g/idProduct"
    echo 0x0200 >"$g/bcdUSB"
    echo 0x0300 >"$g/bcdDevice"
    mkdir -p "$g/strings/0x409" "$g/configs/c.1/strings/0x409"
    echo polaris-diag-v8 >"$g/strings/0x409/serialnumber"
    echo 'Polaris RAM diagnostics' >"$g/strings/0x409/manufacturer"
    echo 'Linux 6.16.7 RAM overlay candidate' >"$g/strings/0x409/product"
    echo ACM >"$g/configs/c.1/strings/0x409/configuration"
    echo 100 >"$g/configs/c.1/MaxPower"
    mkdir "$g/functions/acm.usb0" || return 1
    ln -s "$g/functions/acm.usb0" "$g/configs/c.1/acm.usb0" || return 1
    n=0
    while [ "$n" -lt 60 ]; do
        for c in /sys/class/udc/*; do
            [ -e "$c" ] || continue
            [ -z "$(cat "$c/function" 2>/dev/null)" ] || continue
            if echo "${c##*/}" >"$g/UDC"; then
                echo "ACM bound: ${c##*/}"
                return 0
            fi
        done
        n=$((n+1)); sleep 1
    done
    return 1
}

(
    if setup_usb; then
        while [ ! -c /dev/ttyGS0 ]; do sleep 1; done
        while :; do
            if [ -e /run/start-ubuntu-overlay ]; then sleep 1; continue; fi
            setsid -c /bin/sh /bin/diag-console </dev/ttyGS0 >/dev/ttyGS0 2>&1
            sleep 1
        done
    fi
) &

(
    n=0
    while [ "$n" -lt 90 ]; do
        protect_blocks
        mount_ro vendor ext4 ro,noload /run/vendor || true
        if mount_ro userdata ext4 ro,noload /run/ubuntu; then
            if [ -r /run/ubuntu/etc/polaris-ubuntu-rootfs ]; then
                for module in gpi rmi_core rmi_i2c; do
                    insmod "/lib/modules/6.16.7-sdm845/diag/$module.ko" || true
                done
                echo READY >/run/ubuntu-status
                break
            fi
            umount /run/ubuntu
        fi
        n=$((n+1)); sleep 1
    done
) &

boot_ubuntu_overlay() {
    exec >/dev/ttyGS0 2>&1
    echo 'OVERLAY: checking Ubuntu root'
    [ "$(cat /run/ubuntu-status 2>/dev/null)" = READY ] || return 1
    [ -x /run/ubuntu/usr/lib/systemd/systemd ] || return 1
    echo 'OVERLAY: loading filesystem module'
    insmod /lib/modules/6.16.7-sdm845/diag/overlay.ko || return 1
    echo 'OVERLAY: mounting RAM upper layer'
    mkdir -p /run/overlay /newroot
    mount -t tmpfs -o size=2048m,nosuid,nodev tmpfs /run/overlay || return 1
    mkdir -p /run/overlay/upper /run/overlay/work
    mount -t overlay overlay -o lowerdir=/run/ubuntu,upperdir=/run/overlay/upper,workdir=/run/overlay/work /newroot || return 1
    [ -r /newroot/etc/polaris-ubuntu-rootfs ] || return 1
    echo 'OVERLAY: installing matching modules in RAM'
    mkdir -p /newroot/lib/modules/6.16.7-sdm845
    cp -a /lib/modules/6.16.7-sdm845/. /newroot/lib/modules/6.16.7-sdm845/ || return 1
    mkdir -p /newroot/lib/firmware/qcom/sdm845/polaris
    cp -a /lib/firmware/qcom/sdm845/polaris/. /newroot/lib/firmware/qcom/sdm845/polaris/ || return 1
    mkdir -p /newroot/etc/systemd/system
    for unit in polaris-stability.service polaris-battery.service polaris-performance.service polaris-sim-prepare.service polaris-slpi-guard.service polaris-touch-wake.service polaris-bluetooth-up.service polaris-wifi-up.service polaris-rmnet.service polaris-firstboot-desktop.service polaris-grow-root.service polaris-cleanup-initramfs-watch.service polaris-audio.service apt-daily.service apt-daily.timer apt-daily-upgrade.service apt-daily-upgrade.timer; do
        ln -sfn /dev/null "/newroot/etc/systemd/system/$unit" || return 1
    done
    for f in /newroot/etc/modules-load.d/polaris*; do [ ! -e "$f" ] || rm -f "$f"; done
    echo 'OVERLAY: moving virtual filesystems'
    for point in dev proc sys run tmp; do
        echo "OVERLAY: moving $point"
        mkdir -p "/newroot/$point"
        mount --move "/$point" "/newroot/$point" || return 1
    done
    echo 'POLARIS: starting Ubuntu 26.04 in RAM overlay (userdata read-only)'
    exec /bin/busybox switch_root /newroot /sbin/init
}

trap ':' HUP INT TERM
while :; do
    if [ -e /run/start-ubuntu-overlay ]; then
        sleep 2
        boot_ubuntu_overlay
        echo 'Ubuntu overlay start failed; remaining in RAM diagnostics'
        rm -f /run/start-ubuntu-overlay
    fi
    sleep 1
done
