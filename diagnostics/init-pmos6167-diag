#!/bin/sh
export PATH=/bin:/sbin:/usr/bin:/usr/sbin
/bin/busybox mount -t proc proc /proc
/bin/busybox mount -t sysfs sysfs /sys
/bin/busybox mount -t devtmpfs devtmpfs /dev
/bin/busybox mkdir -p /dev/pts /run /tmp
/bin/busybox mount -t devpts devpts /dev/pts
/bin/busybox mount -t tmpfs tmpfs /run
/bin/busybox mount -t tmpfs tmpfs /tmp
/bin/busybox --install -s /bin
exec >>/run/init.log 2>&1
echo 'POLARIS 6.16.7: RAM diagnostic init running'
echo '<6>POLARIS 6.16.7: RAM diagnostic init running' >/dev/kmsg
if [ -r /lib/firmware/qcom/sdm845/polaris/a630_zap.mbn ]; then
    echo 'GPU ZAP: available in early RAM'
else
    echo 'GPU ZAP: waiting for read-only vendor mount'
fi
uname -a
cat /proc/cmdline
echo 0 >/proc/sys/kernel/panic
echo WAITING >/run/usb-status

# All block devices are read-only for this diagnostic boot. No journal replay,
# package installation, remote processor startup, or switch_root is performed.
protect_blocks() {
    for b in /sys/class/block/*; do
        [ -e "$b" ] || continue
        case "${b##*/}" in sd*|mmcblk*|nvme*)
            blockdev --setro "/dev/${b##*/}" || true
            ;;
        esac
    done
}
mount_ro() {
    part=$1; type=$2; opts=$3; dest=$4
    mkdir -p "$dest"
    for event in /sys/class/block/*/uevent; do
        [ -r "$event" ] || continue
        grep -q "^PARTNAME=$part$" "$event" || continue
        b=${event%/uevent}; dev=/dev/${b##*/}
        blockdev --setro "$dev" || return 1
        mount -t "$type" -o "$opts" "$dev" "$dest" && {
            echo "READ-ONLY: $part at $dev"; return 0;
        }
        return 1
    done
    return 1
}

setup_usb() {
    mkdir -p /sys/kernel/config
    mount -t configfs configfs /sys/kernel/config || return 1
    g=/sys/kernel/config/usb_gadget/polaris_diag
    mkdir "$g" || return 1
    echo 0x0525 >"$g/idVendor"
    echo 0xa4a7 >"$g/idProduct"
    echo 0x0200 >"$g/bcdUSB"
    echo 0x0300 >"$g/bcdDevice"
    mkdir -p "$g/strings/0x409" "$g/configs/c.1/strings/0x409"
    # Retain this phone's existing identity for its narrowly scoped udev rule.
    echo polaris-diag-v8 >"$g/strings/0x409/serialnumber"
    echo 'Polaris RAM diagnostics' >"$g/strings/0x409/manufacturer"
    echo 'Linux 6.16.7 read-only diagnostics' >"$g/strings/0x409/product"
    echo ACM >"$g/configs/c.1/strings/0x409/configuration"
    echo 100 >"$g/configs/c.1/MaxPower"
    mkdir "$g/functions/acm.usb0" || return 1
    ln -s "$g/functions/acm.usb0" "$g/configs/c.1/acm.usb0" || return 1
    n=0
    while [ "$n" -lt 60 ]; do
        for c in /sys/class/udc/*; do
            [ -e "$c" ] || continue
            owner=$(cat "$c/function" 2>/dev/null)
            [ -z "$owner" ] || continue
            if echo "${c##*/}" >"$g/UDC"; then
                echo READY >/run/usb-status
                echo "ACM bound: ${c##*/}"
                return 0
            fi
        done
        n=$((n+1)); sleep 1
    done
    echo FAILED >/run/usb-status
    return 1
}

# Expose the console before peripheral probes so driver failures remain visible.
(
    if setup_usb; then
        while [ ! -c /dev/ttyGS0 ]; do sleep 1; done
        while :; do
            setsid -c /bin/sh /bin/diag-console </dev/ttyGS0 >/dev/ttyGS0 2>&1
            sleep 1
        done
    fi
) &

(
    while :; do
        {
            printf '\033[2J\033[H'
            echo 'POLARIS / LINUX 6.16.7'
            echo 'INIT: RAM DIAGNOSTICS'
            echo 'STORAGE: READ-ONLY; UBUNTU NOT STARTED'
            echo "ACM: $(cat /run/usb-status)"
            echo "UPTIME: $(cut -d ' ' -f 1 /proc/uptime) seconds"
            echo 'Recent init messages:'
            tail -12 /run/init.log
        } >/dev/tty1 2>/dev/null
        sleep 5
    done
) &

(
    sleep 2
    protect_blocks
    mount_ro vendor ext4 ro,noload /run/vendor || true
    if [ -r /run/vendor/firmware/a630_zap.elf ]; then
        mkdir -p /lib/firmware/qcom/sdm845/polaris
        [ -e /lib/firmware/qcom/sdm845/polaris/a630_zap.mbn ] || \
            ln -s /run/vendor/firmware/a630_zap.elf /lib/firmware/qcom/sdm845/polaris/a630_zap.mbn
    fi
    for module in gpi rmi_core rmi_i2c; do
        if insmod "/lib/modules/6.16.7-sdm845/diag/$module.ko"; then
            echo "MODULE OK: $module"
        else
            echo "MODULE FAILED: $module"
        fi
    done
    # Wait for UFS enumeration; protect every discovered disk and partition.
    n=0
    while [ "$n" -lt 60 ]; do
        protect_blocks
        if mount_ro userdata ext4 ro,noload /run/ubuntu; then
            if [ -r /run/ubuntu/etc/os-release ]; then
                cat /run/ubuntu/etc/os-release
            fi
            break
        fi
        n=$((n+1)); sleep 1
    done
) &

trap ':' HUP INT TERM
while :; do sleep 3600 & wait "$!"; done
