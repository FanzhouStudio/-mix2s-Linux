#!/bin/sh
# Manual, RAM-only Ubuntu boot. Keep every physical block device read-only.
export PATH=/bin:/sbin:/usr/bin:/usr/sbin
/bin/busybox mount -t proc proc /proc
/bin/busybox mount -t sysfs sysfs /sys
/bin/busybox mount -t devtmpfs devtmpfs /dev
/bin/busybox mkdir -p /dev/pts /run /tmp /sys/kernel/config
/bin/busybox mount -t devpts devpts /dev/pts
/bin/busybox mount -t tmpfs tmpfs /run
/bin/busybox mount -t tmpfs tmpfs /tmp
/bin/busybox --install -s /bin
exec >>/run/init.log 2>&1
echo 'POLARIS 7.2.8: manual RAM overlay diagnostic started'
uname -a
cat /proc/cmdline
echo 0 >/proc/sys/kernel/panic
echo WAITING >/run/usb-status
echo WAITING >/run/ubuntu-status

protect_blocks() {
    for b in /sys/class/block/*; do
        [ -e "$b" ] || continue
        case "${b##*/}" in
            sd*|mmcblk*|nvme*) blockdev --setro "/dev/${b##*/}" || true ;;
        esac
    done
}

setup_usb() {
    mount -t configfs configfs /sys/kernel/config || return 1
    g=/sys/kernel/config/usb_gadget/polaris_diag
    mkdir "$g" || return 1
    echo 0x0525 >"$g/idVendor"
    echo 0xa4a7 >"$g/idProduct"
    echo 0x0200 >"$g/bcdUSB"
    mkdir -p "$g/strings/0x409" "$g/configs/c.1/strings/0x409"
    echo polaris-linux728-diag >"$g/strings/0x409/serialnumber"
    echo 'Polaris diagnostics' >"$g/strings/0x409/manufacturer"
    echo 'Linux 7.2.8 RAM overlay' >"$g/strings/0x409/product"
    echo ACM >"$g/configs/c.1/strings/0x409/configuration"
    echo 100 >"$g/configs/c.1/MaxPower"
    mkdir "$g/functions/acm.usb0" || return 1
    ln -s "$g/functions/acm.usb0" "$g/configs/c.1/acm.usb0" || return 1
    echo 1 >"$g/functions/acm.usb0/console" || return 1
    n=0
    while [ "$n" -lt 60 ]; do
        for c in /sys/class/udc/*; do
            [ -e "$c" ] || continue
            [ -z "$(cat "$c/function" 2>/dev/null)" ] || continue
            if echo "${c##*/}" >"$g/UDC"; then
                echo READY >/run/usb-status
                echo "ACM bound: ${c##*/}"
                return 0
            fi
        done
        n=$((n+1)); sleep 1
    done
    echo FAILED >/run/usb-status
    return 1
}

(
    if setup_usb; then
        while [ ! -c /dev/ttyGS0 ]; do sleep 1; done
        while :; do
            [ -e /run/start-ubuntu-overlay ] && { sleep 1; continue; }
            setsid -c /bin/sh -i </dev/ttyGS0 >/dev/ttyGS0 2>&1
            sleep 1
        done
    fi
) &
usb_pid=$!

(
    while [ ! -e /run/start-ubuntu-overlay ]; do
        {
            printf '\033[2J\033[H'
            echo 'POLARIS / LINUX 7.2.8'
            echo 'INIT: RAM OVERLAY DIAGNOSTIC'
            echo 'STORAGE: READ-ONLY; UBUNTU NOT STARTED'
            echo "ACM: $(cat /run/usb-status)"
            echo "UPTIME: $(cut -d ' ' -f 1 /proc/uptime) seconds"
            echo 'Recent init messages:'
            tail -8 /run/init.log
        } >/dev/tty1 2>/dev/null
        sleep 5
    done
) &
screen_pid=$!

mount_partition_ro() {
    part=$1; type=$2; opts=$3; dest=$4
    mkdir -p "$dest"
    for event in /sys/class/block/*/uevent; do
        [ -r "$event" ] || continue
        grep -q "^PARTNAME=$part$" "$event" || continue
        b=${event%/uevent}; dev=/dev/${b##*/}
        blockdev --setro "$dev" || return 1
        [ "$(blockdev --getro "$dev")" = 1 ] || return 1
        mount -t "$type" -o "$opts" "$dev" "$dest" || return 1
        grep -q "^$dev $dest $type ro," /proc/mounts || return 1
        echo "READ-ONLY: $part at $dev"
        return 0
    done
    return 1
}

boot_ubuntu_overlay() {
    exec >/dev/ttyGS0 2>&1
    echo 'OVERLAY: mounting vendor firmware and Ubuntu root read-only'
    protect_blocks
    mount_partition_ro vendor ext4 ro,noload /run/vendor || return 1
    [ -r /run/vendor/firmware/a630_zap.elf ] || return 1
    mount_partition_ro userdata ext4 ro,noload /run/ubuntu || return 1
    [ -r /run/ubuntu/etc/polaris-ubuntu-rootfs ] || return 1
    [ -x /run/ubuntu/usr/lib/systemd/systemd ] || return 1
    [ "$(readlink /run/ubuntu/sbin/init)" = /usr/lib/systemd/systemd ] || return 1
    echo 'OVERLAY: loading matching 7.2.8 filesystem module'
    insmod /lib/modules/7.2.8-polaris/diag/overlay.ko || return 1
    mkdir -p /run/overlay /newroot
    mount -t tmpfs -o size=2048m,nosuid,nodev tmpfs /run/overlay || return 1
    mkdir -p /run/overlay/upper /run/overlay/work
    mount -t overlay overlay -o lowerdir=/run/ubuntu,upperdir=/run/overlay/upper,workdir=/run/overlay/work /newroot || return 1
    [ -r /newroot/etc/polaris-ubuntu-rootfs ] || return 1
    echo 'OVERLAY: masking services that require the old kernel or write heavily'
    mkdir -p /newroot/etc/systemd/system
    for unit in polaris-stability.service polaris-battery.service polaris-performance.service polaris-sim-prepare.service polaris-slpi-guard.service polaris-touch-wake.service polaris-bluetooth-up.service polaris-wifi-up.service polaris-rmnet.service polaris-firstboot-desktop.service polaris-grow-root.service polaris-cleanup-initramfs-watch.service polaris-audio.service systemd-modules-load.service apt-daily.service apt-daily.timer apt-daily-upgrade.service apt-daily-upgrade.timer; do
        ln -sfn /dev/null "/newroot/etc/systemd/system/$unit" || return 1
    done
    for f in /newroot/etc/modules-load.d/polaris*; do
        [ ! -e "$f" ] || rm -f "$f" || return 1
    done
    mkdir -p /newroot/lib/modules/7.2.8-polaris/diag
    cp /lib/modules/7.2.8-polaris/diag/overlay.ko /newroot/lib/modules/7.2.8-polaris/diag/overlay.ko || return 1
    echo 'OVERLAY: stopping initramfs workers before switch_root'
    kill "$usb_pid" "$screen_pid" 2>/dev/null || true
    wait "$usb_pid" "$screen_pid" 2>/dev/null || true
    echo 'OVERLAY: moving virtual filesystems'
    for point in dev proc sys run tmp; do
        mkdir -p "/newroot/$point"
        mount --move "/$point" "/newroot/$point" || return 1
    done
    echo 'POLARIS: starting Ubuntu 26.04 with userdata read-only and RAM upper'
    exec /bin/busybox switch_root /newroot /sbin/init
}

trap ':' HUP INT TERM
while :; do
    protect_blocks
    if [ -e /run/start-ubuntu-overlay ]; then
        sleep 2
        boot_ubuntu_overlay
        echo 'Ubuntu overlay start failed; staying in RAM diagnostics'
        rm -f /run/start-ubuntu-overlay
    fi
    sleep 2
done
